# Copy to .env only on the deployment host. Never commit the resulting file.
BLOGOPS_ENVIRONMENT=staging
BLOGOPS_DEBUG=false
BLOGOPS_SECRET_KEY=replace-with-at-least-32-random-characters
BLOGOPS_ALLOWED_HOSTS=api.example.com,api,localhost,127.0.0.1
BLOGOPS_CORS_ORIGINS=
BLOGOPS_DOCS_ENABLED=true
BLOGOPS_METRICS_ENABLED=true
BLOGOPS_METRICS_AUTH_TOKEN=replace-with-at-least-32-random-characters
BLOGOPS_TRUST_PROXY_HEADERS=true

POSTGRES_OWNER_PASSWORD=replace-with-a-url-safe-random-owner-password
POSTGRES_APP_PASSWORD=replace-with-a-url-safe-random-app-password
POSTGRES_WORKER_PASSWORD=replace-with-a-url-safe-random-worker-password
BLOGOPS_DATABASE_URL=postgresql+asyncpg://blogops_app:replace-with-a-url-safe-random-app-password@postgres:5432/blogops
BLOGOPS_WORKER_DATABASE_URL=postgresql+asyncpg://blogops_worker:replace-with-a-url-safe-random-worker-password@postgres:5432/blogops
BLOGOPS_MIGRATION_DATABASE_URL=postgresql+asyncpg://blogops_owner:replace-with-a-url-safe-random-owner-password@postgres:5432/blogops
BLOGOPS_DATABASE_POOL_SIZE=10
BLOGOPS_DATABASE_MAX_OVERFLOW=20
BLOGOPS_DATABASE_POOL_TIMEOUT_SECONDS=10
BLOGOPS_DATABASE_STATEMENT_TIMEOUT_MS=15000

BLOGOPS_REDIS_URL=redis://redis:6379/0
BLOGOPS_REDIS_HEALTH_TIMEOUT_SECONDS=1
BLOGOPS_DEPENDENCY_HEALTH_TIMEOUT_SECONDS=2

MINIO_ROOT_USER=replace-with-random-access-key
MINIO_ROOT_PASSWORD=replace-with-at-least-32-random-characters
BLOGOPS_S3_ENDPOINT_URL=http://object-storage:9000
BLOGOPS_S3_REGION=us-east-1
BLOGOPS_S3_BUCKET=blogops
BLOGOPS_S3_ACCESS_KEY_ID=replace-with-random-access-key
BLOGOPS_S3_SECRET_ACCESS_KEY=replace-with-at-least-32-random-characters
BLOGOPS_KNOWLEDGE_MAX_UPLOAD_BYTES=26214400
BLOGOPS_KNOWLEDGE_FETCH_MAX_BYTES=10485760
BLOGOPS_KNOWLEDGE_FETCH_TIMEOUT_SECONDS=15
BLOGOPS_CLAMAV_HOST=clamav
BLOGOPS_CLAMAV_PORT=3310

BLOGOPS_LOG_LEVEL=INFO
BLOGOPS_OTEL_ENABLED=false
BLOGOPS_OTEL_SERVICE_NAME=blogops-api
BLOGOPS_OTEL_EXPORTER_OTLP_ENDPOINT=
BLOGOPS_PUBLIC_HOST=api.example.com

# Used only with deploy/compose.test.yaml on the isolated validation host.
BLOGOPS_TEST_BIND_HOST=127.0.0.1
BLOGOPS_TEST_PORT=18000
